# AUVÉ dynamic store — environment variables (copy to .env or set in your host's panel)
# Every variable is optional; config.js holds the defaults/placeholders.

PORT=8080

# Password for admin.html  (TODO(client): set a strong one before going live)
ADMIN_PASSWORD=CHANGE-ME-auve-admin

# Razorpay — Dashboard -> Settings -> API Keys  (TODO(client))
# Leave empty to run online payments in labelled TEST mode (orders saved as pay-on-delivery).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket — app.shiprocket.in account login  (TODO(client))
# Leave empty to skip automatic shipment creation.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
